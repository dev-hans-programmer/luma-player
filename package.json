{
  "name": "luma-player-workspace",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @luma/desktop dev",
    "build": "pnpm --filter @luma/desktop build",
    "package:mac": "pnpm --filter @luma/desktop package:mac",
    "package:mac:arm64": "pnpm --filter @luma/desktop package:mac:arm64",
    "package:mac:x64": "pnpm --filter @luma/desktop package:mac:x64",
    "package:mac:universal": "pnpm --filter @luma/desktop package:mac:universal",
    "make:mac": "pnpm --filter @luma/desktop make:mac",
    "make:mac:arm64": "pnpm --filter @luma/desktop make:mac:arm64",
    "make:mac:x64": "pnpm --filter @luma/desktop make:mac:x64",
    "make:mac:universal": "pnpm --filter @luma/desktop make:mac:universal",
    "validate:package": "node scripts/validate-package.mjs",
    "release:check-node": "node scripts/assert-release-node.mjs",
    "native:stage": "node scripts/prepare-native-helper.mjs",
    "build:types": "pnpm --filter @luma/contracts build:types",
    "typecheck": "pnpm --recursive typecheck",
    "lint": "pnpm --recursive lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "test": "pnpm --recursive test",
    "test:e2e": "pnpm --filter @luma/desktop test:e2e",
    "native:build": "swift build --package-path native/macos/MediaMetadataKit --configuration release",
    "native:test": "swift run --package-path native/macos/MediaMetadataKit luma-media-helper-self-test",
    "performance:baseline": "node scripts/performance-baseline.mjs",
    "ci": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "typescript-eslint": "8.70.1"
  }
}
